{
  "global": {
    "max_links_per_day_total": 12,
    "relevance_score_threshold": 70,
    "enable_dry_run": true,
    "warmup_mode": true,
    "warmup_days": 14,
    "local_port": 5000
  },
  "reddit": {
    "max_posts_per_day": 5,
    "min_interval_minutes": 120,
