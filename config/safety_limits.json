  },
  "twitter": {
    "max_original_posts_per_day": 25,
    "min_interval_minutes": 45,
    "jitter_minutes": 15,
    "require_unique_content": true
  },
  "linkedin": {
    "max_posts_per_week": 5,
    "min_interval_hours": 24,
    "business_hours_only": true
  }
}